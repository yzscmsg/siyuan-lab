# SiYuan PoC Caddy - TLS (internal CA) + basicauth in front of the kernel.
# The kernel (siyuan:6806) is NOT published to the LAN; all traffic goes through here.
#
# Known limitation (Caddy 2.8): the internal cert is only served to clients that
# send the IP as SNI. Most browsers do; curl/python/PowerShell on Windows against
# a raw IP do not. For automation and V8 smoke tests, use the plain-HTTP viewer
# on :6901 instead. (ADR-0009: viewer talks only to lifeos-pg, never the kernel.)

{$SITE_ADDRESS:192.168.88.9} {
    tls internal

    # ---- V8 family consumption surface (ADR-0006 / ADR-0009) ----
    # Family members consume LifeOS-published content here. It is a SEPARATE
    # surface from the SiYuan admin console below: the viewer process runs on
    # the host and reaches ONLY lifeos-pg, never the SiYuan kernel.
    #
    # Two viewers run on the host:
    #   - 0.0.0.0:6900 (legacy)
    #   - 0.0.0.0:6901 (preferred; used by V8 smoke)
    # 172.18.0.1 is the siyuan_net bridge gateway (the host as seen from the
    # container). deploy.sh also adds --add-host host.docker.internal:host-gateway
    # so either name works.
    handle_path /family* {
        reverse_proxy 172.18.0.1:6901 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # NOTE: basicauth via `caddy hash-password` is unavailable in this image
    # (returns "Error: EOF" on the PoC host); auth is enforced by the SiYuan
    # lock screen (accessAuthCode) for the UI and the API token (secret store)
    # for /api/* calls. Re-enable basicauth in production once a hash can be
    # generated (see docs/adr/0001).
    handle {
        reverse_proxy siyuan:6806 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}
