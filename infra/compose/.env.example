# SiYuan PoC S1 — compose environment (copy to .env and fill secrets from the host secret store).
# DO NOT commit real secrets. .env is git-ignored.

# Fixed SiYuan version (upgrade/rollback is driven by bumping this tag).
SIYUAN_VERSION=v3.7.3

# Lock-screen / API access auth code. Source: /opt/siyuan-lab/secrets/authcode on the VM.
SIYUAN_ACCESS_AUTH_CODE=CHANGE_ME

# Dedicated non-root account that owns the workspace volume on the host.
PUID=1000
PGID=1000

# Workspace host path (persistent volume for the kernel).
WORKSPACE_DIR=/opt/siyuan-lab/workspace

# Secrets dir on host (chmod 700, owned by root). Holds caddy basicauth hash + authcode.
SECRETS_DIR=/opt/siyuan-lab/secrets

# Published ports for Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# Timezone for kernel logs / daily notes.
TZ=Asia/Shanghai

# Caddy site address (LAN IP for the PoC; replace with DNS name in production).
SITE_ADDRESS=192.168.88.9
